  "block_faq_items": [
    {
      "id": "e9c1b5ff-7930-55bf-879a-77697068459f",
      "faq": "26ac57bf-c3eb-5f4d-8768-c24a8a0169a7",
      "question": "Darf ich nachts angeln?",
      "answer": "<p>Nein. Die Gastkarte gilt von 06:00 bis 22:00 Uhr. Danach muss der Platz abgebaut und der See zeitnah verlassen werden.</p>",
      "sort": 1,
      "user_created": "cead7e19-8211-44c8-acc0-6424dc798460",
      "date_created": "2026-08-15T14:33:13.588Z",
      "user_updated": "cead7e19-8211-44c8-acc0-6424dc798460",
      "date_updated": "2026-08-15T17:43:54.990Z"
    },
    {
      "id": "5b853bcd-c943-5c36-84db-4fe8aaf57dee",
      "faq": "26ac57bf-c3eb-5f4d-8768-c24a8a0169a7",
      "question": "Brauche ich einen Fischereischein?",
      "answer": "<p>Ja. Ein gültiger Bundesfischereischein ist Voraussetzung für die Gastkarte.</p>",
      "sort": 2,
      "user_created": "cead7e19-8211-44c8-acc0-6424dc798460",
      "date_created": "2026-08-15T14:33:13.666Z",
      "user_updated": "cead7e19-8211-44c8-acc0-6424dc798460",
      "date_updated": "2026-08-15T17:43:55.029Z"
    }
  ],
